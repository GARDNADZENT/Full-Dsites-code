{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd .. && npm install --include=optional && npm install --no-save @swc/core-linux-x64-gnu@1.15.41",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/deriv-oauth-start",
      "destination": "https://fanrhtqyjajhacrmrbfv.supabase.co/functions/v1/deriv-oauth-start"
    },
    {
      "source": "/api/deriv-oauth-callback",
      "destination": "https://fanrhtqyjajhacrmrbfv.supabase.co/functions/v1/deriv-oauth-callback"
    },
    {
      "source": "/api/manage-platform-deriv",
      "destination": "https://fanrhtqyjajhacrmrbfv.supabase.co/functions/v1/manage-platform-deriv"
    },
    {
      "source": "/api/manage-site-deriv-apps",
      "destination": "https://fanrhtqyjajhacrmrbfv.supabase.co/functions/v1/manage-site-deriv-apps"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
