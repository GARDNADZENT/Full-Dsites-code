{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd .. && npm install --include=optional",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "node scripts/vercel-ignore-site.js",
  "rewrites": [
    {
      "source": "/api/deriv-oauth-start",
      "destination": "https://dsites-backend.vercel.app/api/deriv-oauth-start"
    },
    {
      "source": "/api/deriv-oauth-callback",
      "destination": "https://dsites-backend.vercel.app/api/deriv-oauth-callback"
    },
    {
      "source": "/api/deriv-trader-session",
      "destination": "https://dsites-backend.vercel.app/api/deriv-trader-session"
    },
    {
      "source": "/api/deriv-trader-accounts",
      "destination": "https://dsites-backend.vercel.app/api/deriv-trader-accounts"
    },
    {
      "source": "/api/deriv-trader-otp",
      "destination": "https://dsites-backend.vercel.app/api/deriv-trader-otp"
    },
    {
      "source": "/api/public-site-config",
      "destination": "https://dsites-backend.vercel.app/api/public-site-config"
    },
    {
      "source": "/((?!api/|site\\.config\\.json).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ]
}
